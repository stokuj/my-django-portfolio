{
    auto_https disable_redirects
}

# Redirect all HTTP traffic to HTTPS using configured host and port.
:80 {
    redir https://{$APP_DOMAIN}:{$CADDY_HTTPS_PORT}{uri} permanent
}

# Redirect HTTPS www -> apex to keep one canonical URL.
https://{$APP_WWW_DOMAIN} {
    redir https://{$APP_DOMAIN}:{$CADDY_HTTPS_PORT}{uri} permanent
}

# Main app host (apex domain).
https://{$APP_DOMAIN} {
 # Static files served directly by Caddy
 handle /static/* {
     root * /srv
     file_server
 }

 handle /media/* {
     root * /srv
     file_server
 }

 # Django app
 reverse_proxy web:8000
}
