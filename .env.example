# Debug flag
DJANGO_DEBUG=True

# Secret key (generate a new one for production)
SECRET_KEY=your_generated_secure_key_here

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Caddy domain configuration
APP_DOMAIN=localhost
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# Database configuration (for localhost, no Docker)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=name_db
DB_USER=postgres
DB_PASSWORD=change-this-to-a-strong-password
DB_HOST=localhost
DB_PORT=5432

# Docker configuration
IMAGE_NAME=name_of_image

DOCKER_DB_ENGINE=django.db.backends.postgresql
DOCKER_DB_NAME=name_db
DOCKER_DB_USER=postgres
DOCKER_DB_PASSWORD=change-this-to-a-strong-password
# Name of container with PostgreSQL
DOCKER_DB_HOST=db
DOCKER_DB_PORT=5432

# Optional portfolio profile (fallbacks are defined in settings.py)
PORTFOLIO_SITE_NAME=My Portfolio
PORTFOLIO_FULL_NAME=John Doe
PORTFOLIO_ROLE_LINE=Junior ABC and DEF.
PORTFOLIO_SPECIALIZATION_LINE=Specialized in X, Y and Z
PORTFOLIO_EMAIL=john.doe@example.com
PORTFOLIO_GITHUB_URL=https://github.com/your-username
PORTFOLIO_LINKEDIN_URL=https://www.linkedin.com/in/your-profile/
