# Debug flag
DJANGO_DEBUG=True

# Secret key (generate a new one for production)
SECRET_KEY=your_generated_secure_key_here

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# GitHub heatmap integration
GITHUB_HEATMAP_TOKEN=your_github_token_with_read_access
HEATMAP_CACHE_TTL_MINUTES=60

# Caddy domain configuration
APP_DOMAIN=localhost
APP_WWW_DOMAIN=www.localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Database configuration (for localhost, no Docker)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=name_db
DB_USER=postgres
DB_PASSWORD=change-this-to-a-strong-password
DB_HOST=localhost
DB_PORT=5432

# Docker configuration
IMAGE_NAME=name_of_image

DOCKER_DB_ENGINE=django.db.backends.postgresql
DOCKER_DB_NAME=name_db
DOCKER_DB_USER=postgres
DOCKER_DB_PASSWORD=change-this-to-a-strong-password

# Name of container with PostgreSQL
DOCKER_DB_HOST=db
DOCKER_DB_PORT=5432

# Celery + Redis (local development defaults)
# Docker Compose overrides these values to use the `redis` service automatically.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Delay worker start (seconds) so web/db/redis can stabilize first
WORKER_START_DELAY_SECONDS=45
