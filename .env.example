# Debug flag — set to False in production
DJANGO_DEBUG=True

# Secret key (generate a new one for production)
SECRET_KEY=your_generated_secure_key_here

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# GitHub heatmap integration
GITHUB_HEATMAP_TOKEN=your_github_token_with_read_access

# Caddy domain configuration
APP_DOMAIN=localhost
APP_WWW_DOMAIN=www.localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Caddy basic_auth in front of /admin (prod only)
# Hash: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the hash in single quotes so Compose does not expand its `$` signs.
ADMIN_BASIC_USER=admin
ADMIN_BASIC_HASH='paste-bcrypt-hash-here'

# Database configuration (for localhost, no Docker)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=name_db
DB_USER=postgres
DB_PASSWORD=change-this-to-a-strong-password
DB_HOST=localhost
DB_PORT=5432

# Docker configuration
DOCKER_DB_ENGINE=django.db.backends.postgresql
DOCKER_DB_NAME=name_db
DOCKER_DB_USER=postgres
DOCKER_DB_PASSWORD=change-this-to-a-strong-password

# Name of container with PostgreSQL
DOCKER_DB_HOST=db
DOCKER_DB_PORT=5432
