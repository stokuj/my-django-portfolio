# Debug flag
DJANGO_DEBUG=True

# Secret key (generate a new one for production)
SECRET_KEY=your_generated_secure_key_here

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Django Sites / GitHub OAuth (django-allauth)
SITE_ID=1
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_ALLOWED_LOGIN=your_github_login
GITHUB_ALLOWED_EMAIL=your-admin-email@example.com
HEATMAP_API_BASE_URL=http://127.0.0.1:8000
HEATMAP_CACHE_TTL_MINUTES=60

# Caddy domain configuration
APP_DOMAIN=localhost
APP_WWW_DOMAIN=www.localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Database configuration (for localhost, no Docker)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=name_db
DB_USER=postgres
DB_PASSWORD=change-this-to-a-strong-password
DB_HOST=localhost
DB_PORT=5432

# Docker configuration
IMAGE_NAME=name_of_image

DOCKER_DB_ENGINE=django.db.backends.postgresql
DOCKER_DB_NAME=name_db
DOCKER_DB_USER=postgres
DOCKER_DB_PASSWORD=change-this-to-a-strong-password

# Name of container with PostgreSQL
DOCKER_DB_HOST=db
DOCKER_DB_PORT=5432

# Celery + Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Delay worker start (seconds) so web/db/redis can stabilize first
WORKER_START_DELAY_SECONDS=45
